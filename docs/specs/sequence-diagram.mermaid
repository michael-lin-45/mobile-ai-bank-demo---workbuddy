%% ============ 6.1 TC-E-002 死 key 自动核查调用链（W3 新增） ============
sequenceDiagram
    participant T as test_dead_keys.py (TC-E-002)
    participant AC as AdminController
    participant REPO as RedisMetricsSnapshotRepository
    participant H2 as H2 (redis_metrics_snapshot)

    T->>AC: GET /api/v1/admin/diagnostics/dead-keys
    AC->>REPO: countDeadKeys(DEAD_KEYS)
    REPO->>H2: SELECT COUNT(*) WHERE metric_key IN (5 keys)
    H2-->>REPO: totalDead (期望 0)
    REPO-->>AC: long
    AC-->>T: ApiResponse{data:{deadKeys,totalDead,allClear}}
    alt totalDead == 0
        T->>T: runner.pass_("TC-E-002")
    else 端点不可达 / 非 200
        T->>T: runner.skip("TC-E-002", 优雅降级)
    else totalDead > 0
        T->>T: runner.fail("TC-E-002")
    end

%% ============ 6.2 TC-J-002 pending_approval ±1 语义集成测试步骤链（W3 新增） ============
sequenceDiagram
    participant T as test_metrics.py (TC-J-002)
    participant CORE as Core /actuator/metrics
    participant BC as BankController (8080)
    participant GES as GraphExecutionEngine
    participant MR as MetricsRegistry

    T->>CORE: GET .../pending_approval?tag=intent:TRANSFER
    CORE-->>T: B (baseline, 如 0)
    T->>BC: POST /api/bank/chat?sessionId=TCJ2_TFR_01 {"message":"转账给李四"}
    BC->>GES: executeGraph(TRANSFER)
    GES->>GES: checkGraphResult → INTERRUPTED
    GES->>MR: addUpDown(+1, intent=TRANSFER)
    BC-->>T: {status: INTERRUPTED}
    T->>CORE: GET .../pending_approval?tag=intent:TRANSFER
    CORE-->>T: V1 (断言 V1 - B == 1)
    T->>BC: POST /api/bank/chat?sessionId=TCJ2_TFR_01 {"message":"500"}
    BC->>GES: resumeGraph(TRANSFER)
    GES->>GES: checkGraphResult → COMPLETED
    GES->>MR: addUpDown(-1, intent=TRANSFER)
    BC-->>T: {status: COMPLETED}
    T->>CORE: GET .../pending_approval?tag=intent:TRANSFER
    CORE-->>T: V2 (断言 V2 - V1 == -1 且 V2 == B)

%% ============ 6.3 P13 / P20 单测链（W3 新增 JUnit） ============
sequenceDiagram
    participant UT as PromptVersionServiceTest
    participant SVC as PromptVersionService
    participant REPO as PromptVersionRepository
    participant H2 as 内嵌 H2

    Note over UT: T-D P20 单测
    UT->>SVC: create(key, c1, m)
    SVC->>REPO: maxVersion(key)=0 → save(v1)
    REPO->>H2: INSERT v1(version=1, ACTIVE)
    UT->>SVC: create(key, c2, m)
    SVC->>REPO: maxVersion(key)=1 → save(v2)
    REPO->>H2: INSERT v2(version=2, DRAFT)
    UT->>SVC: getActive(key)
    SVC->>REPO: findByPromptKeyAndStatusOrderByVersionDesc(ACTIVE)
    REPO-->>SVC: v1 (max ACTIVE)
    UT->>SVC: activate(v2.id)
    SVC->>REPO: 归档 v1→ARCHIVED, v2→ACTIVE
    UT->>REPO: findById(v1.id)
    REPO-->>UT: status==ARCHIVED ✔

    participant RT as InsightsEngineReadonlyTest
    participant IES as InsightsEngineService
    Note over RT: T-C P13 单测
    RT->>IES: 反射 set readOnly=false
    RT->>IES: generateReport()
    IES->>IES: assertReadOnly() → throw
    IES-->>RT: UnsupportedOperationException ✔
