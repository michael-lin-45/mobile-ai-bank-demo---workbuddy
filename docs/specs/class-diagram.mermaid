classDiagram
    %% ===== Q1 死 key 诊断（后端，新增/修改） =====
    class AdminController {
        - RedisMetricsSnapshotRepository snapshotRepository
        - List~String~ DEAD_KEYS
        + deadKeys() : ApiResponse~DeadKeyDiagnostics~
    }
    class RedisMetricsSnapshotRepository {
        + countDeadKeys(List~String~ keys) : long
        + findDeadKeyHits(List~String~ keys) : List~String~
    }
    class RedisMetricsSnapshot {
        + Long id
        + String metricKey
        + String metricType
        + Double metricValue
        + String tags
        + Instant timestamp
    }
    AdminController --> RedisMetricsSnapshotRepository : 查询
    RedisMetricsSnapshotRepository ..> RedisMetricsSnapshot : 映射

    %% ===== Q2 pending_approval（Core，已存在，仅测试契约） =====
    class BankController {
        + chat(sessionId, message) : ResponseEntity
    }
    class AbstractDomainService {
        + executeNewAgent(sessionId, intent, input)
        + resumeActiveAgent(sessionId, input, active)
    }
    class GraphExecutionEngine {
        + executeGraph(...) : Flux~StreamChunk~
        + resumeGraph(...) : Flux~StreamChunk~
    }
    class MetricsRegistry {
        + addUpDown(measure, delta, tags...)
        + getUpDown(measure, tags...) : long
    }
    BankController --> AbstractDomainService : 分发
    AbstractDomainService --> GraphExecutionEngine : execute/resume
    GraphExecutionEngine --> MetricsRegistry : +1 / -1 (pending_approval)

    %% ===== P13 只读闸门（已存在，补 JUnit 验证） =====
    class InsightsEngineService {
        - boolean readOnly
        + generateReport() : Map
        + refresh() : Map
        - assertReadOnly() : void
    }
    InsightsEngineService ..> UnsupportedOperationException : readOnly=false 时抛出

    %% ===== P20 提示词版本化（已存在，补 JUnit 验证） =====
    class PromptVersionService {
        + create(key, content, model) : PromptVersion
        + getActive(key) : PromptVersion
        + activate(id) : PromptVersion
        + listByPromptKey(key) : List~PromptVersion~
    }
    class PromptVersionRepository {
        + maxVersion(key) : int
        + findByPromptKeyAndStatusOrderByVersionDesc(key, status) : List~PromptVersion~
        + findById(id) : Optional~PromptVersion~
    }
    class PromptVersion {
        + Long id
        + String promptKey
        + int version
        + String content
        + String model
        + String status
    }
    PromptVersionService --> PromptVersionRepository
    PromptVersionRepository ..> PromptVersion
