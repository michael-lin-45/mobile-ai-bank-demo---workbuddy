classDiagram
    class ConfusionMatrixData {
        +string[] labels
        +number[][] matrix
    }
    class ConfusionStats {
        +number[][] rowNormalized
        +number cramersV
        +number total
        +ConfusionPair[] topPairs
    }
    class ConfusionPair {
        +string actual
        +string predicted
        +number pct
    }
    class confusionStats {
        +rowNormalize(m: number[][]) number[][]
        +computeCramersV(m: number[][]) number
        +computeTopConfusionPairs(labels, m, topN) ConfusionPair[]
    }
    class HeatmapChart {
        +string[] xLabels
        +string[] yLabels
        +number[][] matrix
        +boolean showCramers
        +boolean showTopPairs
        +boolean narrow
        +render()
    }
    class AccuracyTab {
        +loadData()
        +buildSummaryItems(stats) items
    }
    class ZoneMetric {
        +string title
        +value: string|number
        +string color
        +string delta
        +boolean deltaUp
        +boolean goodWhenUp
        +number[] sparkData
        +badge
    }
    class MiniSpark {
        +number[] data
        +string color
    }
    class ZoneBadge {
        +string letter
        +string color
    }
    class ActionItem {
        +string title
        +string severity
        +InsightTabKey tab
    }
    class ActionList {
        +ActionItem[] actions
        +renderDeepLink()
    }
    class RagRunMetrics {
        +number reorderP95Ms
        +number recallDocs
        +number triggerRate
        +number retrieveErrRate
        +number reorderErrRate
    }
    class RagQualityData {
        +topK
        +table
    }
    class RagPanel {
        +RagRunMetrics run
        +RagQualityData quality
        +render()
    }
    class RagQualityChart {
        +render()
    }

    ConfusionMatrixData ..> ConfusionStats : compute
    confusionStats ..> ConfusionStats : builds
    ConfusionStats *-- ConfusionPair
    HeatmapChart ..> ConfusionMatrixData : consumes
    HeatmapChart ..> confusionStats : derives stats
    AccuracyTab ..> HeatmapChart : renders
    ZoneCSemantic ..> ZoneMetric : builds
    ZoneDBusiness ..> ZoneMetric : builds
    ZoneERag ..> ZoneMetric : builds(goodWhenUp)
    ZoneMetric ..> MiniSpark : sparkData
    ZoneBadge <.. ZoneCSemantic : header
    ZoneBadge <.. ZoneDBusiness : header
    ZoneBadge <.. ZoneERag : header
    ActionList ..> ActionItem : renders deep link
    RagPanel ..> RagRunMetrics : shows 5 KPIs
    RagPanel ..> RagQualityData : quality panel
    RagPanel ..> RagQualityChart : distribution
